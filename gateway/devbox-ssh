#!/bin/sh
# Single SSH entry point from the gateway container into minyanmate-dev.
# Used by the devbox MCP server and by acpx (opencode acp).
exec ssh -T -p 2222 -i /home/node/.config/dev_acp \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile=/home/node/.config/dev_known_hosts \
  -o LogLevel=ERROR \
  node@minyanmate-dev "$@"
